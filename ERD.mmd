%% EcoConnect — Firestore ERD (single diagram, paste-ready)
%% PK = document id · FK = string pointer, not an enforced foreign key
erDiagram
    USERS ||--o| SESSIONS : holds
    USERS ||--o{ USER_LOCATIONS : streams
    USERS ||--o{ DEVICES : registers
    USERS ||--o| SHARED_LOCATIONS : shares
    USERS ||--o{ VERIFICATION_REQUESTS : submits
    USERS ||--o| TRUCKS : assigned_to
    USERS ||--o{ ROUTES : broadcasts
    USERS ||--o{ ROUTE_PLANS : assigned
    USERS ||--o{ TRIP_TICKETS : drives
    USERS ||--o{ ASSIGNMENT_MANUALS : rostered
    USERS ||--o{ MANUALS : authors
    USERS ||--o{ MEMOS : sends
    USERS ||--o{ DELAY_REPORTS : files
    USERS ||--o{ COLLECTION_REQUESTS : requests
    USERS ||--o{ WASTE_SUBMISSIONS : submits
    USERS ||--o{ COMPLAINTS : files
    USERS ||--o{ INCIDENTS : reports
    USERS ||--o{ COMMUNITY_POSTS : writes
    USERS ||--o{ NOTIFICATIONS : receives
    USERS ||--o{ EVENT_PARTICIPANTS : joins
    USERS ||--o{ COLLECTION_POINTS : serves
    USERS ||--o{ ADMIN_AUDIT : acts_in
    TRUCKS ||--o{ TRIP_TICKETS : used_on
    TRUCKS ||--o{ ASSIGNMENT_MANUALS : rostered_to
    ROUTE_PLANS ||--o| ROUTES : activated_as
    MANUAL_REQUESTS ||--o| MANUALS : answered_by
    MANUAL_REQUESTS ||--o| ASSIGNMENT_MANUALS : answered_by
    MANUALS ||--o{ MANUAL_VERSIONS : has
    ASSIGNMENT_MANUALS ||--o| TRIP_TICKETS : generates
    TRIP_TICKETS ||--o{ DELAY_REPORTS : delayed_by
    DELAY_REPORTS ||--o| ANNOUNCEMENTS : published_as
    EVENTS ||--o{ EVENT_PARTICIPANTS : has
    EVENTS ||--o{ EVENT_STREETS : tallies

