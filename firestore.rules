rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {

    // The newest login owns the account. sessions/{uid}.authTime is the sign-in
    // time of that login; a token issued before it belongs to a replaced device
    // and is refused everywhere, even if that device was offline or modified.
    // Accounts with no session yet are unaffected.
    function sessionCurrent() {
      let path = /databases/$(database)/documents/sessions/$(request.auth.uid);
      return !exists(path)
        || request.auth.token.get('auth_time', 0) >= get(path).data.get('authTime', 0);
    }

    function signedIn() {
      return request.auth != null && sessionCurrent();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Admin is the role field on the user's own profile; signup can't set it.
    function isAdmin() {
      return signedIn() && profile(request.auth.uid).role == 'admin';
    }

    // Iswim owns the fleet and issues the trip tickets.
    function isIswim() {
      return signedIn() && profile(request.auth.uid).role == 'iswim';
    }

    // City Hall is the DSQC: the super admin that provisions accounts.
    function isCityHall() {
      return signedIn() && profile(request.auth.uid).role == 'cityHall';
    }

    function isAuditViewer() {
      return signedIn()
        && hasProfile(request.auth.uid)
        && profile(request.auth.uid).role == 'auditor'
        && profile(request.auth.uid).get('accountStatus', 'active') == 'active';
    }

    // Everyone who touches a trip ticket.
    function isTicketStakeholder() {
      return isAdmin() || isIswim() || isCityHall();
    }

    // The crew runs the fleet together. A guide holds the device for a driver
    // without a phone, so the guide has to read the truck's paperwork even
    // though the ticket is issued against the driver's login. Only approved
    // crew accounts get this, and only for reading.
    function isCrew() {
      return isActive()
        && profile(request.auth.uid).get('crewRole', '') in ['driver', 'guide'];
    }

    // A deleted user keeps their login, so access also requires a profile.
    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Drivers start 'pending' and must be approved by an admin. Profiles made
    // before approval existed have no field and count as active.
    function isActive() {
      return signedIn() && hasProfile(request.auth.uid)
        && profile(request.auth.uid).role != 'auditor'
        && profile(request.auth.uid).get('accountStatus', 'active') == 'active';
    }

    // Sending an ID is the resident's own step: it never needs the barangay's
    // permission. The desk still makes the decision, so an account that is
    // already verified has nothing left to send.
    function canSendId() {
      return signedIn()
        && hasProfile(request.auth.uid)
        && profile(request.auth.uid).get('verificationStatus', 'unverified')
             != 'verified';
    }

    // Avatars are stored inline in the profile, so cap their size.
    function photoOk(data) {
      return !('photoUrl' in data) || data.photoUrl == null
        || (data.photoUrl is string && data.photoUrl.size() < 150000);
    }

    // The resident answers the barangay's registration approval. Either the
    // fields are untouched, or the write is exactly the one allowed transition
    // (approved -> accepted / declined) stamped with the server time.
    // A resident still waiting for the barangay, whose email Firebase has
    // confirmed, may send the one "new registration" notice to barangay staff.
    function pendingRegistrationNotice() {
      return signedIn()
        && hasProfile(request.auth.uid)
        && profile(request.auth.uid).role == 'user'
        && profile(request.auth.uid).get('accountStatus', 'active') == 'pending'
        && request.auth.token.get('email_verified', false) == true
        && request.resource.data.userId == 'staff'
        && request.resource.data.get('type', '') == 'account';
    }

    // A resident who sends a photo from the dashboard puts their own record
    // back in line for review: 'pending', with the old reason cleared. That is
    // the only profile change they may make here — never 'verified', never a
    // reason of their own — and the desk still makes the decision.
    function residentIdResubmission() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['verificationStatus', 'rejectionReason'])
        || (request.resource.data.get('verificationStatus', 'unverified')
              == 'pending'
            && resource.data.get('verificationStatus', 'unverified')
                 != 'verified'
            && request.resource.data.get('rejectionReason', null) == null
            && changed.hasOnly(['verificationStatus', 'rejectionReason']));
    }

    function residentAnswer() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['registrationStatus', 'registrationDecidedAt'])
        || (resource.data.get('registrationStatus', 'accepted') == 'approved'
            && request.resource.data.registrationStatus in ['accepted', 'declined']
            && request.resource.data.registrationDecidedAt == request.time);
    }

    // Inline uploads (images / PDFs) are capped below Firestore's 1 MiB limit.
    function uploadOk(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is map
            && data[field].dataUrl is string
            && data[field].dataUrl.size() < 900000);
    }

    function uploadListOk(data, field) {
      // An empty list is valid; indexing it would raise a rule error and deny
      // the write, so the size check short-circuits first.
      return !(field in data) || data[field] == null
        || (data[field] is list
            && data[field].size() <= 3
            && (data[field].size() == 0 || data[field][0].dataUrl is string));
    }

    // Community post reactions: a member may add or remove only their own
    // like, and may only append a comment that names them as the author.
    function changesOnlyOwnLike(uid) {
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      return after is list
        && after.toSet().difference(before.toSet()).hasOnly([uid])
        && before.toSet().difference(after.toSet()).hasOnly([uid])
        && after.size() <= before.size() + 1;
    }

    function appendsOnlyOwnComment(uid) {
      let before = resource.data.get('comments', []);
      let after = request.resource.data.get('comments', []);
      return after is list
        && (after == before
            || (after.size() == before.size() + 1
                // An empty slice raises an index error, so a post's first
                // reply skips the history check.
                && (before.size() == 0 || after[0:before.size()] == before)
                && after[before.size()].keys()
                     .hasOnly(['id', 'authorId', 'authorName', 'body', 'createdAt'])
                && after[before.size()].authorId == uid
                && after[before.size()].authorName is string
                && after[before.size()].authorName.size() <= 80
                && after[before.size()].authorName
                     == profile(uid).get('name', after[before.size()].authorName)
                && after[before.size()].body is string
                && after[before.size()].body.size() <= 1000));
    }

    function isRemoved(uid) {
      return exists(/databases/$(database)/documents/removed_users/$(uid));
    }

    match /users/{userId} {
      // Iswim needs the driver directory to issue tickets; City Hall needs it
      // to provision the accounts Iswim asks for.
      allow read: if isSelf(userId) || isAdmin() || isIswim() || isCityHall();
      // Two ways a profile is born:
      //  1. self sign-up — residents only, pending until the barangay checks
      //     their ID. Confirming their email (the Firebase link) and that ID
      //     check both come before they may sign in;
      //  2. City Hall provisions every crew, staff and Iswim login, and Iswim
      //     provisions its own colleagues and the crew logins. Those profiles
      //     arrive already active. The barangay creates no accounts.
      allow create: if (isSelf(userId)
        && !isRemoved(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.get('barangay', '') == 'Batasan Hills'
        && (!('registrationStatus' in request.resource.data)
            || request.resource.data.registrationStatus == 'pending')
        && (!('accountType' in request.resource.data)
            || request.resource.data.accountType in ['resident', 'government'])
        && (!('verificationStatus' in request.resource.data)
            || request.resource.data.verificationStatus == 'pending')
        && request.resource.data.get('emailVerified', false) == false
        && !('points' in request.resource.data)
        && photoOk(request.resource.data))
        || (isCityHall()
          && !isRemoved(userId)
          && request.resource.data.role in
               ['iswim', 'driver', 'admin', 'cityHall', 'auditor']
          && request.resource.data.accountStatus == 'active'
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['resident', 'government'])
          && !('points' in request.resource.data)
          && photoOk(request.resource.data))
        // Iswim provisions its own colleagues and the crew logins. It can
        // never mint a barangay, City Hall or audit account.
        || (isIswim()
          && !isRemoved(userId)
          && request.resource.data.role in ['iswim', 'driver']
          && request.resource.data.accountStatus == 'active'
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['resident', 'government'])
          && !('points' in request.resource.data)
          && photoOk(request.resource.data));
      // The barangay cannot mint accounts. It reviews the ones that arrive
      // (see the update rule below), but provisioning belongs to City Hall.
      allow update: if (isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'accountStatus', 'points', 'pointsUpdatedAt',
                         'accountType', 'verifiedBy',
                         'verificationDate', 'approvedAt',
                         // Set by the barangay desk when it approves the
                         // registration; the resident only answers it.
                         'registrationApprovedAt'])
          // "Email confirmed" is only true when Firebase says so.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['emailVerified'])
              || request.resource.data.emailVerified
                   == request.auth.token.get('email_verified', false))
          && residentIdResubmission()
          && residentAnswer()
          && photoOk(request.resource.data))
        || isCityHall()
        // The barangay desk reviews accounts but never hands out roles: a
        // driver, Iswim or City Hall login is provisioned by City Hall.
        || (isAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role']));
      // Not their own profile: that would lock the admin out for good.
      allow delete: if isAdmin() && request.auth.uid != userId;

      // Private location history: only its owner can read it. Staff can read
      // it solely once the user is being deleted (the tombstone exists), so the
      // delete-user cleanup can list and remove it.
      match /locations/{locationId} {
        allow read: if isSelf(userId) || (isAdmin() && isRemoved(userId));
        // !isRemoved also covers the window while an admin delete is running.
        allow write: if isSelf(userId) && hasProfile(userId) && !isRemoved(userId);
        allow delete: if isAdmin();
      }

      // Device tokens for push notifications. Only the owner writes their own
      // token; the Cloud Function reads them with admin credentials.
      match /devices/{deviceId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isSelf(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform is string;
        allow delete: if isSelf(userId) || isAdmin();
      }
    }

    // One active sign-in per account: the newest login writes its session id
    // here and other devices sign themselves out when it stops matching theirs.
    match /sessions/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && (isActive() || isAuditViewer())
        && !isRemoved(userId)
        && request.resource.data.keys().hasOnly(['sessionId', 'startedAt', 'platform', 'authTime'])
        && request.resource.data.authTime == request.auth.token.get('auth_time', -1)
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 16
        && request.resource.data.sessionId.size() <= 64;
      allow delete: if isAdmin();
    }

    // Trip tickets. Iswim issues them, the driver accepts and runs them, then
    // Barangay -> Iswim -> City Hall sign in that order. Content is frozen the
    // moment the first signature lands; only the signature map and the status
    // may move after that.
    match /trip_tickets/{ticketId} {
      allow read: if isTicketStakeholder()
        || (signedIn() && resource.data.driverId == request.auth.uid)
        // The guide's list shows every plate's ticket state, and the guide is
        // not the driver the ticket names, so crew read the roster's tickets.
        || isCrew();
      allow create: if isIswim()
        && request.resource.data.status == 'issued'
        && request.resource.data.code is string
        && request.resource.data.plateNumber is string;
      allow update: if (isTicketStakeholder()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['signatures', 'status', 'pendingSigner', 'completedAt',
                         'approvalPending', 'history', 'revisionReason',
                         'rejectionReason']))
        // A manual still waiting for City Hall's signature is not the driver's
        // to take: the ticket only becomes theirs once it is 'valid'.
        || (isSelf(resource.data.driverId)
          && isActive()
          && resource.data.get('approvalPending', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'pendingSigner', 'acceptedAt', 'startedAt',
                         'submittedAt', 'declineReason', 'history'])
          && request.resource.data.status in
               ['accepted', 'declined', 'running', 'submitted'])
        // A manual ticket ends when the driver marks the approved run done;
        // there is no end time to close it automatically.
        || (isSelf(resource.data.driverId)
          && isActive()
          && resource.data.get('kind', 'run') == 'assignment'
          && resource.data.status == 'valid'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedAt', 'history'])
          && request.resource.data.status == 'completed');
      allow delete: if isCityHall();
    }

    // Per-year ticket counters. Only Iswim issues tickets, so only Iswim moves
    // the counter.
    match /counters/{counterId} {
      allow read: if isTicketStakeholder();
      allow write: if isIswim() || isCityHall();
    }

    // The barangay fleet. Iswim registers the plates and pairs each one with a
    // named driver; City Hall links the login. A truck is never saved without
    // a driver, and every signed-in member may read the roster: a driver needs
    // his own truck, a resident needs the plate on the map.
    match /trucks/{truckId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && !isAuditViewer();
      allow create, update: if (isIswim() || isCityHall())
        && request.resource.data.plateNumber is string
        && request.resource.data.plateNumber.size() > 0
        && request.resource.data.wheelers is int
        && request.resource.data.centerLatitude is number
        && request.resource.data.centerLongitude is number;
      allow delete: if isCityHall();
    }

    // Written by an admin when deleting a user; blocks re-creating the profile.
    match /removed_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Retired: locations are no longer published for others to see. A driver's
    // live position lives in routes/{uid}; a resident's never leaves their own
    // device and private history. Only deletes remain, to purge old documents.
    match /shared_locations/{userId} {
      allow read: if isSelf(userId);
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Iswim dispatches a driver's day here (it used to be the barangay desk).
    // The driver may only flip their own assignment from scheduled ->
    // active/completed.
    match /routePlans/{planId} {
      // Residents may read a plan while it is being run, so the tracking map can
      // show the same stops the driver sees. Finished and scheduled plans stay
      // private to the driver and the dispatching desks.
      allow read: if signedIn()
        && !isAuditViewer()
        && (isIswim()
            || isCityHall()
            || isAdmin()
            || resource.data.driverId == request.auth.uid
            || resource.data.status == 'active');
      allow create: if isIswim()
        || isCityHall()
        || (isActive()
            && request.resource.data.driverId == request.auth.uid
            && request.resource.data.adHoc == true
            && request.resource.data.status == 'scheduled');
      allow update: if isIswim()
        || isCityHall()
        || (isActive()
            && resource.data.driverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'activatedAt', 'completedAt', 'sessionId'])
            && request.resource.data.status in ['active', 'completed']);
      allow delete: if isIswim() || isCityHall();
    }

    // Live driver locations: any signed-in user can watch, only the driver
    // (or an admin) can publish. Drivers cannot rewrite identity fields.
    match /routes/{driverId} {
      allow read: if signedIn() && !isAuditViewer();
      allow create: if (isSelf(driverId) && isActive()) || isAdmin();
      allow update: if (isSelf(driverId)
          && isActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'lat', 'lng', 'updatedAt', 'lastSeenAt', 'startedAt',
               'endedAt', 'planId', 'sessionId', 'etaMinutes', 'driverName',
               'phone', 'zone', 'pausedAt', 'resumedAt', 'completedAt',
               'pauseReason', 'locationState', 'locationUpdatedAt',
               'lastKnownLat', 'lastKnownLng',
               // trip guard + fleet identity written at activation
               'truckPlate', 'truckWheelers', 'crewRole', 'connectionState',
               'geofenceState', 'geofenceMeters', 'geofenceLat', 'geofenceLng',
               'geofenceRadius'
             ])
          && request.resource.data.status in
               ['inTransit', 'delayed', 'paused', 'completed', 'idle']
          && (!('locationState' in request.resource.data)
              || request.resource.data.locationState in
                   ['ok', 'disabled', 'permission', 'offline', 'unknown']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Keep historical incident reports available to staff; new resident
    // reports now go through complaints or collection requests.
    match /incidents/{incidentId} {
      allow read: if isAdmin() || isCityHall();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Barangay announcements. Residents read published posts, staff manage all.
    match /announcements/{announcementId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && !isAuditViewer()
        && (isAdmin() || resource.data.status == 'published');
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.status in ['draft', 'published']
        && uploadOk(request.resource.data, 'image');
      allow delete: if isAdmin();
    }

    // An event residents may still sign up for: it exists, is published and has
    // not ended (same 4-hour default as the app when no end time is set).
    function eventOpen(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId);
      return exists(path)
        && get(path).data.status == 'published'
        && request.time < (get(path).data.get('endAt', null) != null
             ? get(path).data.endAt
             : get(path).data.startAt + duration.value(4, 'h'));
    }

    // The street counters are only allowed to move together with the caller's
    // own sign-up row, in the same write. `bucket` is the street key, or
    // '_none' for a resident with no street.
    function keyMatches(bucket, storedKey) {
      return bucket == '_none' ? storedKey == '' : storedKey == bucket;
    }

    function joinsAs(eventId, bucket) {
      let me = /databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid);
      return eventOpen(eventId)
        && !exists(me)
        && existsAfter(me)
        && keyMatches(bucket, getAfter(me).data.streetKey);
    }

    function leavesAs(eventId, bucket) {
      let me = /databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid);
      return exists(me)
        && !existsAfter(me)
        && keyMatches(bucket, get(me).data.streetKey);
    }

    // Community events.
    match /events/{eventId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && !isAuditViewer()
        && (isAdmin() || resource.data.status == 'published');
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 6000
        && request.resource.data.startAt is timestamp
        && request.resource.data.status in ['draft', 'published']
        && uploadOk(request.resource.data, 'image');
      allow delete: if isAdmin();

      // Event sign-ups. A resident may only write their own row, and only the
      // fields the roster needs — the street is copied in at join time so the
      // per-street ranking still works after a profile edit.
      // Only the resident and staff can read a row (name, street, barangay).
      // Other residents see the anonymous street counters below instead.
      match /participants/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        // Create-only: the street and join time recorded at the first sign-up
        // can never be rewritten to move attendance to another street. The app
        // checks for an existing row first, so a second tap is a no-op rather
        // than a write; leaving and joining again starts a fresh row.
        allow create: if isActive()
          && request.auth.uid == uid
          && !isRemoved(uid)
          && eventOpen(eventId)
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'street', 'streetKey', 'barangay', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.street is string
          && request.resource.data.street.size() <= 160
          && request.resource.data.streetKey is string
          && request.resource.data.streetKey.size() <= 160
          && request.resource.data.barangay is string
          && request.resource.data.barangay.size() <= 120
          && request.resource.data.joinedAt == request.time;
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // Anonymous per-street headcount shown to every resident: a street label
      // and a number, never a name or user id. A resident can only add or remove
      // their own single place, in the same write as their sign-up row; staff
      // can repair the counters.
      match /streets/{bucket} {
        allow read: if signedIn() && hasProfile(request.auth.uid)
          && !isAuditViewer();
        allow create: if isActive()
          && !isRemoved(request.auth.uid)
          && request.resource.data.keys().hasOnly(['label', 'count'])
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 160
          && request.resource.data.count == 1
          && joinsAs(eventId, bucket);
        allow update: if isActive()
          && !isRemoved(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && ((request.resource.data.count == resource.data.count + 1
               && joinsAs(eventId, bucket))
              || (request.resource.data.count == resource.data.count - 1
                  && request.resource.data.count >= 1
                  && leavesAs(eventId, bucket)));
        allow delete: if (isActive()
            && resource.data.count == 1
            && leavesAs(eventId, bucket));
        allow create, update, delete: if isAdmin();
      }
    }

    // Collection requests. Special requests require a verified government
    // profile; that check is repeated here so hiding the UI is not enough.
    match /collectionRequests/{requestId} {
      allow read: if signedIn() && !isAuditViewer() && (
        isAdmin()
        || isCityHall()
        || resource.data.requesterId == request.auth.uid
        || resource.data.assignedDriverId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['resident', 'special', 'uncollected']
        // Every approved resident may ask for a special pickup: their ID was
        // checked by the barangay at sign-up (isActive above).
        && (request.resource.data.kind == 'resident'
            || profile(request.auth.uid).role == 'user')
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.estimatedQuantity is string
        && request.resource.data.location is string
        && request.resource.data.preferredDate is timestamp
        && uploadListOk(request.resource.data, 'images');
      // Staff drive the workflow; the assigned driver may only advance their
      // own job to inProgress/collected.
      allow update: if isAdmin()
        || isCityHall()
        || (isSelf(resource.data.assignedDriverId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt', 'history'])
            && request.resource.data.status in ['inProgress', 'collected']);
      allow delete: if isAdmin()
        || (isSelf(resource.data.requesterId)
            && resource.data.status == 'pending');
    }

    // Waste uploads and their validation.
    match /wasteSubmissions/{submissionId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 3;
      allow update, delete: if isAdmin();
    }

    // Government ID submissions. Readable only by the applicant and staff.
    match /verificationRequests/{requestId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Sending an ID never needs the barangay's permission: the resident
      // always makes the decision to send, the desk makes the decision to
      // approve, and the write pins the record back to 'pending'.
      allow create: if isSelf(request.resource.data.userId)
        && canSendId()
        && request.resource.data.status == 'pending'
        // Every resident uploads an ID at sign-up; government accounts too.
        && request.resource.data.accountType in ['resident', 'government']
        && request.resource.data.document is map
        && request.resource.data.document.dataUrl is string
        && request.resource.data.document.dataUrl.size() < 900000;
      // A resubmission goes to the record named after the resident, so nothing
      // here reads the rejected one: an ID saved by an older version of the
      // app (no owner field, a status this build never sends) can always be
      // replaced instead of locking the resident out.
      allow update: if isSelf(requestId)
        && canSendId()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        // Every resident uploads an ID at sign-up; government accounts too.
        && request.resource.data.accountType in ['resident', 'government']
        && request.resource.data.document is map
        && request.resource.data.document.dataUrl is string
        && request.resource.data.document.dataUrl.size() < 900000;
      allow update, delete: if isAdmin();
    }

    // In-app notifications. Residents may notify themselves or the City Hall
    // desk; only staff, Iswim and City Hall may notify other users. Each desk
    // reads its own shared channel: `staff`, `cityHall` or `iswim`.
    match /notifications/{notificationId} {
      allow read: if signedIn() && !isAuditViewer() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.userId == 'cityHall' && isCityHall())
        || (resource.data.userId == 'iswim' && isIswim())
      );
      allow create: if ((isActive()
        && request.resource.data.userId is string
        && (request.resource.data.userId == request.auth.uid
            || request.resource.data.userId == 'staff'
            || request.resource.data.userId == 'cityHall'
            || (request.resource.data.userId == 'iswim'
                && (isIswim() || isCityHall() || isAdmin()))
            || profile(request.auth.uid).role == 'admin'
            || profile(request.auth.uid).role == 'iswim'
            || profile(request.auth.uid).role == 'cityHall'
            // Drivers send truck alerts and job updates, nothing else.
            || (profile(request.auth.uid).role == 'driver'
                && request.resource.data.get('type', '') in ['route', 'request'])))
          || pendingRegistrationNotice())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false;
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || ((resource.data.userId == 'cityHall' && isCityHall()
              || resource.data.userId == 'iswim' && isIswim())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
            || isAdmin()
            || (resource.data.userId == 'cityHall' && isCityHall())
            || (resource.data.userId == 'iswim' && isIswim()));
    }

    // Community feed. Any active member may post; neighbours may react and
    // reply, while only the author or an admin may delete.
    match /communityPosts/{postId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && !isAuditViewer();
      allow create: if isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && uploadOk(request.resource.data, 'image');
      allow update: if isAdmin()
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likedBy', 'comments', 'updatedAt'])
            && changesOnlyOwnLike(request.auth.uid)
            && appendsOnlyOwnComment(request.auth.uid));
      allow delete: if isAdmin() || resource.data.authorId == request.auth.uid;
    }

    // Designated collection points.
    match /collectionPoints/{pointId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && !isAuditViewer();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if isAdmin();
    }

    // Delay reports: Iswim files, DSQC pushes to the district officer, the
    // barangay keeps the copy.
    match /delay_reports/{reportId} {
      allow read: if isTicketStakeholder();
      allow create: if isIswim()
        && request.resource.data.stage == 'dsqc'
        && request.resource.data.minutesLate is int;
      allow update: if isCityHall() || isAdmin();
      allow delete: if isCityHall();
    }

    // Memos, endorsements, announcements and manual requests between City
    // Hall, Iswim and the barangay.
    match /memos/{memoId} {
      allow read: if isTicketStakeholder();

      // The author files it against a desk they do not belong to. `photo` is
      // still accepted so records written before attachments were typed keep
      // validating if they are ever re-created by a migration.
      allow create: if isTicketStakeholder()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toChannel in ['iswim', 'barangay', 'cityHall']
        && request.resource.data.fromRole != request.resource.data.toChannel
        && request.resource.data.status == 'sent'
        && uploadOk(request.resource.data, 'attachment')
        && uploadOk(request.resource.data, 'photo');

      // A signed memo is final: no edit and no delete once acknowledged.
      allow update: if resource.data.get('status', 'sent') != 'acknowledged' && (
        // The recipient desk opens it, once.
        (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'receivedAt'])
         && request.resource.data.status == 'received'
         && resource.data.get('status', 'sent') == 'sent'
         && ((resource.data.toChannel == 'cityHall' && isCityHall())
             || (resource.data.toChannel == 'iswim' && isIswim())
             || (resource.data.toChannel == 'barangay' && isAdmin())))
        // City Hall signs the memo addressed to it, in its own name.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acknowledgedAt', 'acknowledgedByUid',
                        'acknowledgedByName', 'acknowledgementSignature'])
            && request.resource.data.status == 'acknowledged'
            && resource.data.toChannel == 'cityHall'
            && isCityHall()
            && request.resource.data.acknowledgedByUid == request.auth.uid)
        // The author corrects their own memo before it is received.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['subject', 'body', 'attachment', 'editedAt'])
            && resource.data.get('status', 'sent') == 'sent'
            && resource.data.fromUid == request.auth.uid
            && request.resource.data.subject is string
            && request.resource.data.subject.size() <= 200
            && request.resource.data.body is string
            && request.resource.data.body.size() <= 4000
            && uploadOk(request.resource.data, 'attachment'))
      );

      allow delete: if isCityHall()
        && resource.data.get('status', 'sent') != 'acknowledged';
    }

    // Outgoing mail to the district officer. No SMTP: this is the record.
    // The District Officer has no account; City Hall keeps their email address
    // so ISWIM announcements can be sent from City Hall's own email app.
    match /settings/districtOfficer {
      allow read: if isCityHall();
      allow write: if isCityHall()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;
    }

    match /email_log/{entryId} {
      allow read: if isCityHall() || isAdmin();
      allow create: if isIswim();
      allow update, delete: if isCityHall();
    }

    // Controlled manuals. The direct Iswim -> City Hall workflow is enforced
    // here: only those two roles can read, and only City Hall can acknowledge.
    match /manuals/{manualId} {
      allow read: if isIswim() || isCityHall();
      allow create: if isIswim()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.summary is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.version == 1
        && uploadOk(request.resource.data, 'file');
      allow update: if (isIswim()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['draft', 'submitted']
          && uploadOk(request.resource.data, 'file'))
        || (isCityHall()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledgedAt', 'acknowledgedByName']));
      allow delete: if isIswim();

      // Version history is append-only.
      match /versions/{versionId} {
        allow read: if isIswim() || isCityHall();
        allow create: if isIswim()
          && request.resource.data.version is int
          && request.resource.data.version > 0
          && request.resource.data.notes is string
          && uploadOk(request.resource.data, 'file');
        allow update, delete: if false;
      }
    }

    // City Hall requests a manual from Iswim; Iswim links the submission.
    match /manual_requests/{requestId} {
      allow read: if isIswim() || isCityHall();
      allow create: if isCityHall()
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isIswim() || isCityHall();
      allow delete: if isCityHall();
    }

    // The collection manual Iswim builds from a City Hall request: one driver,
    // the truck that comes with him, up to three routes, days, a start time and
    // a recurrence. It is only visible to residents once City Hall approves it.
    match /assignment_manuals/{manualId} {
      allow read: if isIswim() || isCityHall() || isAdmin() || isCrew()
        || (isActive() && profile(request.auth.uid).role == 'driver')
        || (isActive()
          && profile(request.auth.uid).role == 'user'
          && resource.data.status == 'approved');
      allow create: if isIswim()
        && request.resource.data.status == 'pendingApproval'
        && request.resource.data.driverName is string
        && request.resource.data.plateNumber is string
        && request.resource.data.startTime is string;
      allow update: if isIswim() || isCityHall();
      allow delete: if isIswim() || isCityHall();
    }

    // Resident complaints go straight to DSQC / City Hall. The barangay is
    // deliberately not a reader here.
    match /complaints/{complaintId} {
      allow read: if isCityHall()
        || (signedIn() && resource.data.residentId == request.auth.uid);
      allow create: if isActive()
        && profile(request.auth.uid).role == 'user'
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.referenceNo is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && uploadListOk(request.resource.data, 'images');
      // City Hall works the complaint. The resident may only add one reply of
      // their own to the thread while it is still open.
      allow update: if isCityHall()
        || (isActive()
            && resource.data.residentId == request.auth.uid
            && resource.data.status in ['pending', 'underReview']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['responses', 'updatedAt'])
            && appendsOnlyResidentReply());
      allow delete: if isCityHall();
    }

    function appendsOnlyResidentReply() {
      let before = resource.data.get('responses', []);
      let after = request.resource.data.get('responses', []);
      // Checked in this order so a list that did not grow by one is refused
      // before the new entry is read.
      return after is list
        && after.size() == before.size() + 1
        // An empty slice raises an index error, so a first reply skips it.
        && (before.size() == 0 || after[0:before.size()] == before)
        && isResidentReply(after[before.size()]);
    }

    function isResidentReply(added) {
      return added is map
        && added.keys().hasOnly(['message', 'byName', 'byRole', 'at'])
        && added.byRole == 'resident'
        && added.message is string
        && added.message.size() > 0
        && added.message.size() <= 2000
        && added.byName is string
        && added.byName.size() <= 80
        && added.at is timestamp;
    }

    // Trusted Cloud Functions append audit entries; clients cannot write them.
    match /admin_audit/{entryId} {
      allow read: if isAdmin() || isCityHall() || isAuditViewer();
      allow create, update, delete: if false;
    }
  }
}
