rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Admin is the `role` field on the user's own profile; signup can't set it.
    function isAdmin() {
      return signedIn() && profile(request.auth.uid).role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.role in ['user', 'driver'];
      allow update: if (isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin();
      allow delete: if isAdmin();

      match /locations/{locationId} {
        allow read, write: if isSelf(userId);
        allow read, delete: if isAdmin();
      }
    }

    match /shared_locations/{userId} {
      allow read: if signedIn() && request.auth.token.email_verified == true;
      allow create, update: if isSelf(userId)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.accuracy is number
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.displayName is string
        && request.resource.data.role == profile(userId).role;
      allow delete: if isSelf(userId) || isAdmin();
    }
  }
}
