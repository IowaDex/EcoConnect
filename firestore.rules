rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {

    // The newest login owns the account. sessions/{uid}.authTime is the sign-in
    // time of that login; a token issued before it belongs to a replaced device
    // and is refused everywhere, even if that device was offline or modified.
    // Accounts with no session yet are unaffected.
    function sessionCurrent() {
      let path = /databases/$(database)/documents/sessions/$(request.auth.uid);
      return !exists(path)
        || request.auth.token.get('auth_time', 0) >= get(path).data.get('authTime', 0);
    }

    function signedIn() {
      return request.auth != null && sessionCurrent();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Admin is the role field on the user's own profile; signup can't set it.
    function isAdmin() {
      return signedIn() && profile(request.auth.uid).role == 'admin';
    }

    // A deleted user keeps their login, so access also requires a profile.
    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Drivers start 'pending' and must be approved by an admin. Profiles made
    // before approval existed have no field and count as active.
    function isActive() {
      return signedIn() && hasProfile(request.auth.uid)
        && profile(request.auth.uid).get('accountStatus', 'active') == 'active';
    }

    // Government-only features are gated here, not just in the UI.
    function isVerifiedGovernment() {
      return isActive()
        && profile(request.auth.uid).get('accountType', 'resident') == 'government'
        && profile(request.auth.uid).get('verificationStatus', 'unverified') == 'verified';
    }

    // Avatars are stored inline in the profile, so cap their size.
    function photoOk(data) {
      return !('photoUrl' in data) || data.photoUrl == null
        || (data.photoUrl is string && data.photoUrl.size() < 150000);
    }

    // Inline uploads (images / PDFs) are capped below Firestore's 1 MiB limit.
    function uploadOk(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is map
            && data[field].dataUrl is string
            && data[field].dataUrl.size() < 900000);
    }

    function uploadListOk(data, field) {
      // An empty list is valid; indexing it would raise a rule error and deny
      // the write, so the size check short-circuits first.
      return !(field in data) || data[field] == null
        || (data[field] is list
            && data[field].size() <= 3
            && (data[field].size() == 0 || data[field][0].dataUrl is string));
    }

    // Community post reactions: a member may add or remove only their own
    // like, and may only append a comment that names them as the author.
    function changesOnlyOwnLike(uid) {
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      return after is list
        && after.toSet().difference(before.toSet()).hasOnly([uid])
        && before.toSet().difference(after.toSet()).hasOnly([uid])
        && after.size() <= before.size() + 1;
    }

    function appendsOnlyOwnComment(uid) {
      let before = resource.data.get('comments', []);
      let after = request.resource.data.get('comments', []);
      return after is list
        && (after == before
            || (after.size() == before.size() + 1
                && after[0:before.size()] == before
                && after[before.size()].keys()
                     .hasOnly(['id', 'authorId', 'authorName', 'body', 'createdAt'])
                && after[before.size()].authorId == uid
                && after[before.size()].authorName is string
                && after[before.size()].authorName.size() <= 80
                // The sign-in token carries the Auth display name once it has
                // refreshed; a brand-new token has none, so only pin when set.
                && after[before.size()].authorName
                     == request.auth.token.get('name', after[before.size()].authorName)
                && after[before.size()].body is string
                && after[before.size()].body.size() <= 1000));
    }

    function isRemoved(uid) {
      return exists(/databases/$(database)/documents/removed_users/$(uid));
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && !isRemoved(userId)
        // Drivers start 'pending' until an admin approves; nobody self-credits
        // points or self-verifies a government account.
        && ((request.resource.data.role == 'user'
              && request.resource.data.accountStatus == 'active')
            || (request.resource.data.role == 'driver'
              && request.resource.data.accountStatus == 'pending'))
        && (!('accountType' in request.resource.data)
            || request.resource.data.accountType in ['resident', 'government'])
        && (!('verificationStatus' in request.resource.data)
            || request.resource.data.verificationStatus
                 == (request.resource.data.get('accountType', 'resident') == 'government'
                      ? 'pending'
                      : 'unverified'))
        && !('points' in request.resource.data)
        && photoOk(request.resource.data);
      allow update: if (isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'accountStatus', 'points', 'pointsUpdatedAt',
                         'accountType', 'verificationStatus', 'verifiedBy',
                         'verificationDate', 'rejectionReason', 'approvedAt'])
          && photoOk(request.resource.data))
        || isAdmin();
      // Not their own profile: that would lock the admin out for good.
      allow delete: if isAdmin() && request.auth.uid != userId;

      // Private location history: only its owner can read it. Staff can read
      // it solely once the user is being deleted (the tombstone exists), so the
      // delete-user cleanup can list and remove it.
      match /locations/{locationId} {
        allow read: if isSelf(userId) || (isAdmin() && isRemoved(userId));
        // !isRemoved also covers the window while an admin delete is running.
        allow write: if isSelf(userId) && hasProfile(userId) && !isRemoved(userId);
        allow delete: if isAdmin();
      }
    }

    // One active sign-in per account: the newest login writes its session id
    // here and other devices sign themselves out when it stops matching theirs.
    match /sessions/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && isActive()
        && !isRemoved(userId)
        && request.resource.data.keys().hasOnly(['sessionId', 'startedAt', 'platform', 'authTime'])
        && request.resource.data.authTime == request.auth.token.get('auth_time', -1)
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 16
        && request.resource.data.sessionId.size() <= 64;
      allow delete: if isAdmin();
    }

    // Written by an admin when deleting a user; blocks re-creating the profile.
    match /removed_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Retired: locations are no longer published for others to see. A driver's
    // live position lives in routes/{uid}; a resident's never leaves their own
    // device and private history. Only deletes remain, to purge old documents.
    match /shared_locations/{userId} {
      allow read: if isSelf(userId);
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Staff (admin) schedule a driver's day here. The driver may only flip
    // their own assignment from scheduled -> active/completed.
    match /routePlans/{planId} {
      // Residents may read a plan while it is being run, so the tracking map can
      // show the same stops the driver sees. Finished and scheduled plans stay
      // private to the driver and staff.
      allow read: if signedIn()
        && (isAdmin()
            || resource.data.driverId == request.auth.uid
            || resource.data.status == 'active');
      allow create: if isAdmin()
        || (isActive()
            && request.resource.data.driverId == request.auth.uid
            && request.resource.data.adHoc == true
            && request.resource.data.status == 'scheduled');
      allow update: if isAdmin()
        || (isActive()
            && resource.data.driverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'activatedAt', 'completedAt', 'sessionId'])
            && request.resource.data.status in ['active', 'completed']);
      allow delete: if isAdmin();
    }

    // Live driver locations: any signed-in user can watch, only the driver
    // (or an admin) can publish. Drivers cannot rewrite identity fields.
    match /routes/{driverId} {
      allow read: if signedIn();
      allow create: if (isSelf(driverId) && isActive()) || isAdmin();
      allow update: if (isSelf(driverId)
          && isActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'lat', 'lng', 'updatedAt', 'lastSeenAt', 'startedAt',
               'endedAt', 'planId', 'sessionId', 'etaMinutes', 'driverName',
               'phone', 'zone', 'pausedAt', 'resumedAt', 'completedAt',
               'pauseReason', 'locationState', 'locationUpdatedAt',
               'lastKnownLat', 'lastKnownLng'
             ])
          && request.resource.data.status in
               ['inTransit', 'delayed', 'paused', 'completed', 'idle']
          && (!('locationState' in request.resource.data)
              || request.resource.data.locationState in
                   ['ok', 'disabled', 'permission', 'offline', 'unknown']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Recycling station ledger. Staff credit points here; the balance itself
    // lives on users/{uid}.points and can only be changed by an admin.
    match /dropOffs/{dropOffId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.residentId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.points is int
        && request.resource.data.points > 0
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0;
      allow update, delete: if isAdmin();
    }

    // Incident reports: residents create and read their own, staff see all.
    match /incidents/{incidentId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.residentId == request.auth.uid);
      allow create: if isSelf(request.resource.data.residentId);
      allow update, delete: if isAdmin();
    }

    // Barangay announcements. Residents read published posts, staff manage all.
    match /announcements/{announcementId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && (isAdmin() || resource.data.status == 'published');
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.status in ['draft', 'published']
        && uploadOk(request.resource.data, 'image');
      allow delete: if isAdmin();
    }

    // An event residents may still sign up for: it exists, is published and has
    // not ended (same 4-hour default as the app when no end time is set).
    function eventOpen(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId);
      return exists(path)
        && get(path).data.status == 'published'
        && request.time < (get(path).data.get('endAt', null) != null
             ? get(path).data.endAt
             : get(path).data.startAt + duration.value(4, 'h'));
    }

    // Community events.
    match /events/{eventId} {
      allow read: if signedIn() && hasProfile(request.auth.uid)
        && (isAdmin() || resource.data.status == 'published');
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 6000
        && request.resource.data.startAt is timestamp
        && request.resource.data.status in ['draft', 'published']
        && uploadOk(request.resource.data, 'image');
      allow delete: if isAdmin();

      // Event sign-ups. A resident may only write their own row, and only the
      // fields the roster needs — the street is copied in at join time so the
      // per-street ranking still works after a profile edit.
      match /participants/{uid} {
        allow read: if signedIn() && hasProfile(request.auth.uid);
        // Create-only: the street and join time recorded at the first sign-up
        // can never be rewritten to move attendance to another street. The app
        // checks for an existing row first, so a second tap is a no-op rather
        // than a write; leaving and joining again starts a fresh row.
        allow create: if isActive()
          && request.auth.uid == uid
          && !isRemoved(uid)
          && eventOpen(eventId)
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'street', 'streetKey', 'barangay', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.street is string
          && request.resource.data.street.size() <= 160
          && request.resource.data.streetKey is string
          && request.resource.data.streetKey.size() <= 160
          && request.resource.data.barangay is string
          && request.resource.data.barangay.size() <= 120
          && request.resource.data.joinedAt == request.time;
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }
    }

    // Collection requests. Special requests require a verified government
    // profile; that check is repeated here so hiding the UI is not enough.
    match /collectionRequests/{requestId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.requesterId == request.auth.uid
        || resource.data.assignedDriverId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['resident', 'special']
        && (request.resource.data.kind == 'resident' || isVerifiedGovernment())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.estimatedQuantity is string
        && request.resource.data.location is string
        && request.resource.data.preferredDate is timestamp
        && uploadListOk(request.resource.data, 'images');
      // Staff drive the workflow; the assigned driver may only advance their
      // own job to inProgress/collected.
      allow update: if isAdmin()
        || (isSelf(resource.data.assignedDriverId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt', 'history'])
            && request.resource.data.status in ['inProgress', 'collected']);
      allow delete: if isAdmin()
        || (isSelf(resource.data.requesterId)
            && resource.data.status == 'pending');
    }

    // Waste uploads and their validation.
    match /wasteSubmissions/{submissionId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 3;
      allow update, delete: if isAdmin();
    }

    // Government ID submissions. Readable only by the applicant and staff.
    match /verificationRequests/{requestId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSelf(request.resource.data.userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.accountType == 'government'
        && request.resource.data.document is map
        && request.resource.data.document.dataUrl is string
        && request.resource.data.document.dataUrl.size() < 900000;
      allow update, delete: if isAdmin();
    }

    // In-app notifications. Residents may notify themselves or the shared staff
    // channel; only staff and drivers (truck proximity alerts) may notify other
    // users. Only the recipient (or staff) can read a notification.
    match /notifications/{notificationId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.userId is string
        && (request.resource.data.userId == request.auth.uid
            || request.resource.data.userId == 'staff'
            || profile(request.auth.uid).role == 'admin'
            // Drivers send truck alerts and job updates, nothing else.
            || (profile(request.auth.uid).role == 'driver'
                && request.resource.data.get('type', '') in ['route', 'request']))
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false;
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || isAdmin();
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Community feed. Any active member may post; neighbours may react and
    // reply, while only the author or an admin may delete.
    match /communityPosts/{postId} {
      allow read: if signedIn() && hasProfile(request.auth.uid);
      allow create: if isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && uploadOk(request.resource.data, 'image');
      allow update: if isAdmin()
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likedBy', 'comments', 'updatedAt'])
            && changesOnlyOwnLike(request.auth.uid)
            && appendsOnlyOwnComment(request.auth.uid));
      allow delete: if isAdmin() || resource.data.authorId == request.auth.uid;
    }

    // Designated collection points.
    match /collectionPoints/{pointId} {
      allow read: if signedIn() && hasProfile(request.auth.uid);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if isAdmin();
    }

    // Who changed roles, approved or deleted accounts. Append-only: admins can
    // add entries naming themselves, and nobody can edit or delete them.
    match /admin_audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
