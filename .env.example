# Copy this file to .env and fill in your Firebase project values.
# .env is gitignored; Docker reads it automatically via docker compose.
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

ENVIRONMENT=production

# Only for tool/seed_demo_accounts.mjs: the shared password for the demo
# accounts it creates. Choose your own; never commit it.
ECO_SEED_PASSWORD=

# Optional: web push. Create a Web Push certificate in Firebase Console >
# Project settings > Cloud Messaging and paste the key pair here.
FIREBASE_VAPID_KEY=
