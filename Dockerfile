# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage 1 — build the Flutter web bundle
# ---------------------------------------------------------------------------
FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app

# Firebase config is baked into the compiled web bundle, so it must be
# supplied at build time. Values come from your local .env (docker compose
# passes them automatically) or from --build-arg.
ARG FIREBASE_API_KEY=""
ARG FIREBASE_AUTH_DOMAIN=""
ARG FIREBASE_PROJECT_ID=""
ARG FIREBASE_STORAGE_BUCKET=""
ARG FIREBASE_MESSAGING_SENDER_ID=""
ARG FIREBASE_APP_ID=""
ARG ENVIRONMENT="production"

# Resolve dependencies first so this layer is cached between code changes.
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .

# Generate the .env asset the app loads at runtime (flutter_dotenv).
RUN if [ -z "$FIREBASE_API_KEY" ] || [ -z "$FIREBASE_PROJECT_ID" ]; then \
      echo "ERROR: FIREBASE_API_KEY and FIREBASE_PROJECT_ID are required build args." >&2; \
      echo "       Create a .env file next to docker-compose.yml (see .env.example)." >&2; \
      exit 1; \
    fi && \
    printf '%s\n' \
      "# Generated by Dockerfile from build args" \
      "FIREBASE_API_KEY=$FIREBASE_API_KEY" \
      "FIREBASE_AUTH_DOMAIN=$FIREBASE_AUTH_DOMAIN" \
      "FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID" \
      "FIREBASE_STORAGE_BUCKET=$FIREBASE_STORAGE_BUCKET" \
      "FIREBASE_MESSAGING_SENDER_ID=$FIREBASE_MESSAGING_SENDER_ID" \
      "FIREBASE_APP_ID=$FIREBASE_APP_ID" \
      "" \
      "ENVIRONMENT=$ENVIRONMENT" > .env

RUN flutter build web --release

# ---------------------------------------------------------------------------
# Stage 2 — serve the static bundle with nginx
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
